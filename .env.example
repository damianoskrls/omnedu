# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://omnedu:omnedu_dev@localhost:5432/omnedu?schema=public"
POSTGRES_USER=omnedu
POSTGRES_PASSWORD=omnedu_dev
POSTGRES_DB=omnedu

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32_CHAR_MIN
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── App ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Cloudinary (media uploads) ───────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OpenAI (ανάγνωση διατροφολόγιου από JPG/PDF) ─────
# Προαιρετικό. Τα PDF με επιλέξιμο κείμενο διαβάζονται και χωρίς κλειδί.
OPENAI_API_KEY=

# ── Firebase (FCM push notifications) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Resend (email notifications) ─────────────────────
# Free tier: 3,000 emails/month, 100/day — https://resend.com
# RESEND_FROM_EMAIL must be from a verified domain in your Resend account.
# If not set, email sending is silently skipped (logged as a warning).
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com
